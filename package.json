{
  "name": "rohat-tech",
  "version": "0.1.0",
  "private": true,
  "description": "Rohat Tech maishiy texnika savdo ilovasi MVP monorepo.",
  "scripts": {
    "dev": "npm run dev -ws",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3"
  }
}
